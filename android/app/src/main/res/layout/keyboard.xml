<?xml version="1.0" encoding="utf-8"?>
<!-- Inflated by the input method service, which has no AppCompat inflater: android:tint is the one that works. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/keyboard_background"
    tools:ignore="UseAppTint,Overdraw"
    android:clipChildren="false"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingTop="6dp"
    android:paddingEnd="4dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/mode"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/chip_background"
            android:contentDescription="@string/action_cycle_mode"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/key_foreground"
            android:textSize="13sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/undo"
            style="@style/BarButton"
            android:contentDescription="@string/action_undo"
            android:src="@drawable/ic_undo" />

        <ImageButton
            android:id="@+id/settings"
            style="@style/BarButton"
            android:contentDescription="@string/action_settings"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="3"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="@color/keyboard_secondary_text"
        android:textSize="14sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:clipChildren="false">

        <View
            android:id="@+id/halo"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center"
            android:background="@drawable/microphone_halo"
            android:visibility="invisible" />

        <ImageButton
            android:id="@+id/microphone"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center"
            android:background="@drawable/microphone_background"
            android:contentDescription="@string/action_start"
            android:padding="21dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_mic" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/microphone_idle"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/cancel"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:background="@drawable/chip_background"
            android:contentDescription="@string/action_cancel"
            android:scaleType="center"
            android:src="@drawable/ic_close"
            android:tint="@color/key_foreground"
            android:translationX="-96dp"
            android:visibility="invisible" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/switch_keyboard"
            style="@style/Key"
            android:contentDescription="@string/action_switch_keyboard"
            android:src="@drawable/ic_keyboard" />

        <TextView
            android:id="@+id/comma"
            style="@style/Key"
            android:text="@string/key_comma" />

        <TextView
            android:id="@+id/period"
            style="@style/Key"
            android:text="@string/key_period" />

        <ImageButton
            android:id="@+id/space"
            style="@style/Key"
            android:layout_weight="2"
            android:contentDescription="@string/action_space"
            android:src="@drawable/ic_space" />

        <TextView
            android:id="@+id/cursor_left"
            style="@style/Key"
            android:contentDescription="@string/action_cursor_left"
            android:text="@string/key_cursor_left" />

        <TextView
            android:id="@+id/cursor_right"
            style="@style/Key"
            android:contentDescription="@string/action_cursor_right"
            android:text="@string/key_cursor_right" />

        <ImageButton
            android:id="@+id/backspace"
            style="@style/Key"
            android:contentDescription="@string/action_backspace"
            android:src="@drawable/ic_backspace" />

        <ImageButton
            android:id="@+id/enter"
            style="@style/Key"
            android:contentDescription="@string/action_enter"
            android:src="@drawable/ic_return" />
    </LinearLayout>
</LinearLayout>
